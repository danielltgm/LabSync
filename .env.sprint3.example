# Additional build configuration. Append to private .env.local; keep Firebase config.
# These are planning inputs for the check script; native wiring is a programmer task.
# No values below are service-account keys. Never put Admin secrets in EXPO_PUBLIC_*.
LABSYNC_API_ORIGIN=
LABSYNC_ANDROID_PACKAGE=
LABSYNC_ANDROID_GOOGLE_SERVICES_FILE=
GOOGLE_MAPS_ANDROID_API_KEY=
LABSYNC_IOS_BUNDLE_IDENTIFIER=
LABSYNC_IOS_GOOGLE_SERVICES_FILE=
# Only needed if Google Maps is selected for iOS instead of Apple Maps.
GOOGLE_MAPS_IOS_API_KEY=
