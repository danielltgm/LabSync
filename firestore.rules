rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The document fields and supported query shapes are in docs/sprint-2-contract.md.
    // Profiles, classes and enrollments are provisioned by a trusted operator.
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function hasRole(role) {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function managesClass(classId) {
      return hasRole('ASISTEN') &&
        get(/databases/$(database)/documents/classes/$(classId)).data.assistantUid == request.auth.uid;
    }

    function enrolledIn(classId) {
      return hasRole('PRAKTISAN') &&
        exists(/databases/$(database)/documents/enrollments/$(request.auth.uid)/classes/$(classId));
    }

    function isValidSessionUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        ((resource.data.status == 'TERJADWAL' && request.resource.data.status == 'DIBUKA') ||
         (resource.data.status == 'DIBUKA' && request.resource.data.status == 'SELESAI'));
    }

    function canReadStudentRecord(data) {
      return (hasRole('PRAKTISAN') && isOwner(data.studentUid)) || managesClass(data.classId);
    }

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow create: if isOwner(uid) &&
        request.resource.data.keys().hasOnly(['name', 'identifier', 'role']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.identifier is string &&
        request.resource.data.identifier.size() > 0 &&
        request.resource.data.role in ['ASISTEN', 'PRAKTISAN'];
    }

    match /classes/{classId} {
      allow get: if enrolledIn(classId);
      allow read: if hasRole('ASISTEN') && isOwner(resource.data.assistantUid);
      allow create: if hasRole('ASISTEN') &&
        request.resource.data.assistantUid == request.auth.uid &&
        request.resource.data.keys().hasOnly(['name', 'assistantUid']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0;
      allow update: if managesClass(classId) &&
        request.resource.data.assistantUid == request.auth.uid &&
        request.resource.data.keys().hasOnly(['name', 'assistantUid']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0;
      allow delete: if managesClass(classId);
    }

    match /enrollments/{uid}/classes/{classId} {
      allow read: if hasRole('PRAKTISAN') && isOwner(uid);
      allow create: if managesClass(classId) &&
        request.resource.data.keys().hasOnly(['enrolledAt']) &&
        request.resource.data.enrolledAt is timestamp;
      allow delete: if managesClass(classId);
    }

    match /sessions/{sessionId} {
      allow read: if enrolledIn(resource.data.classId) || managesClass(resource.data.classId);
      allow create: if managesClass(request.resource.data.classId) &&
        request.resource.data.status == 'TERJADWAL' &&
        request.resource.data.keys().hasOnly(['classId', 'courseName', 'className', 'labRoom', 'date', 'startTime', 'endTime', 'assistantName', 'status']) &&
        request.resource.data.courseName is string &&
        request.resource.data.className is string &&
        request.resource.data.labRoom is string &&
        request.resource.data.date is string &&
        request.resource.data.startTime is string &&
        request.resource.data.endTime is string &&
        request.resource.data.assistantName is string;
      allow update: if managesClass(resource.data.classId) &&
        (isValidSessionUpdate() ||
         (resource.data.status == 'TERJADWAL' &&
          request.resource.data.status == 'TERJADWAL' &&
          request.resource.data.classId == resource.data.classId));
      allow delete: if managesClass(resource.data.classId) && resource.data.status == 'TERJADWAL';
    }

    match /attendance/{attendanceId} {
      allow read: if canReadStudentRecord(resource.data);
    }

    match /leaveRequests/{requestId} {
      allow read: if canReadStudentRecord(resource.data);
    }
  }
}