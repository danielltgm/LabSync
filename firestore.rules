rules_version = '2';

// LabSync Sprint 3. Schema: docs/firebase.md.
//
// Every change goes through the server (POST /api/act with firebase-admin), which runs the shared
// business logic and writes the audit log. Clients only READ, except three narrow writes:
//   - their own notifications' readAt,
//   - their own bottom-bar slots (users/{nim}.navSlots),
//   - their own quiz answers while the attempt is running.
// Auth uid == NIM/NIP, so `request.auth.uid` is the user's NIM.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return signedIn() && me().role == 'SUPERADMIN';
    }
    function isStaff() {
      return signedIn() && me().role in ['ASISTEN', 'SUPERADMIN'];
    }
    // Class-scoped docs carry `staffNims` (the class's asisten) and `nim` (the student it is about).
    function ownsOrStaffs() {
      return signedIn() && (isAdmin() || resource.data.nim == request.auth.uid ||
        ('staffNims' in resource.data && request.auth.uid in resource.data.staffNims));
    }
    function staffsClassDoc() {
      return signedIn() && (isAdmin() || ('staffNims' in resource.data && request.auth.uid in resource.data.staffNims));
    }

    // Profiles: your own, every staff profile (asisten names/phones on class pages), and staff see all.
    match /users/{nim} {
      allow get: if signedIn() && (nim == request.auth.uid || isStaff() || resource.data.role in ['ASISTEN', 'SUPERADMIN']);
      allow list: if signedIn() && (isStaff() || resource.data.role in ['ASISTEN', 'SUPERADMIN']);
      allow update: if signedIn() && nim == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['navSlots']) &&
        request.resource.data.navSlots is list && request.resource.data.navSlots.size() <= 3;
    }

    // Shared reference data: rooms, photos, courses, classes, meetings, grade columns.
    // Any signed-in user may read (the map shows which rooms are busy, students see their schedule).
    match /labs/{id} { allow read: if signedIn(); }
    match /labPhotos/{id} { allow read: if signedIn(); }
    match /courses/{id} { allow read: if signedIn(); }
    match /classes/{id} { allow read: if signedIn(); }
    match /sessions/{id} { allow read: if signedIn(); }
    match /assignments/{id} { allow read: if signedIn(); }

    // Personal records: the student it is about, the class's asisten, the koordinator.
    match /attendance/{id} { allow read: if ownsOrStaffs(); }
    match /leaves/{id} { allow read: if ownsOrStaffs(); }
    match /checkinAttempts/{id} { allow read: if ownsOrStaffs(); }
    match /grades/{id} { allow read: if ownsOrStaffs(); }

    match /notifications/{id} {
      allow read: if signedIn() && resource.data.nim == request.auth.uid;
      allow update: if signedIn() && resource.data.nim == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']) &&
        request.resource.data.readAt is int;
    }

    // Audit log: written by the server only, never edited or deleted.
    match /log/{id} { allow read: if staffsClassDoc(); }

    // Quizzes: questions without answers. Students see opened/closed quizzes; drafts are staff-only.
    match /quizzes/{id} {
      allow read: if signedIn() && (resource.data.status in ['DIBUKA', 'DITUTUP'] || staffsClassDoc());
    }
    // Answer keys: staff only.
    match /quizKeys/{id} { allow read: if staffsClassDoc(); }
    // QR signing secret of an open session: staff only (students would otherwise forge codes).
    match /sessionSecrets/{id} { allow read: if staffsClassDoc(); }
    // meta/* (audit chain head) is server-only: no client access.

    match /quizAttempts/{id} {
      allow read: if ownsOrStaffs();
      // Saving answers while the attempt runs. Everything else (start, violations, submit) is server-side.
      allow update: if signedIn() && resource.data.nim == request.auth.uid &&
        resource.data.status == 'MENGERJAKAN' && request.time.toMillis() < resource.data.deadline &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answers']) &&
        request.resource.data.answers is map;
    }
  }
}
