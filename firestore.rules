rules_version = '2';

// Data model and access scopes are documented in docs/sprint-2-contract.md.
service cloud.firestore {
  match /databases/{database}/documents {
    // The document fields and supported query shapes are in docs/sprint-2-contract.md.
    // Profiles, classes and enrollments are provisioned by a trusted operator.
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function hasRole(role) {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function managesClass(classId) {
      return hasRole('ASISTEN') &&
        get(/databases/$(database)/documents/classes/$(classId)).data.assistantUid == request.auth.uid;
    }

    function enrolledIn(classId) {
      return hasRole('PRAKTISAN') &&
        exists(/databases/$(database)/documents/classes/$(classId)) &&
        exists(/databases/$(database)/documents/enrollments/$(request.auth.uid)/classes/$(classId));
    }

    function isValidSessionUpdate() {
      return (
        (resource.data.status == 'TERJADWAL' && request.resource.data.status == 'DIBUKA' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'attendanceConfig'])) ||
        (resource.data.status == 'DIBUKA' && request.resource.data.status == 'SELESAI' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
      );
    }

    function canReadStudentRecord(data) {
      return (hasRole('PRAKTISAN') && isOwner(data.studentUid)) || managesClass(data.classId);
    }

    function validText(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    function validId(value) {
      return validText(value, 128) && value.matches('^[^/]+$');
    }

    function isValidClassification(data) {
      return data is map && data.keys().hasAll(['status']) &&
        ((data.status in ['pending', 'unavailable'] && data.keys().hasOnly(['status'])) ||
         (data.status == 'classified' && data.keys().hasOnly(['status', 'category']) &&
          data.keys().hasAll(['category']) && validText(data.category, 120)));
    }

    function isValidLeaveRequest(data) {
      return data.keys().hasAll(['sessionId', 'classId', 'studentUid', 'reason', 'submittedAt', 'classification', 'decision']) &&
        data.keys().hasOnly(['sessionId', 'classId', 'studentUid', 'reason', 'submittedAt', 'classification', 'decision',
          'studentName', 'studentId', 'reviewedBy', 'reviewedAt', 'classificationStartedAt']) &&
        validId(data.sessionId) && validId(data.classId) && validId(data.studentUid) &&
        validText(data.reason, 4000) && data.submittedAt is timestamp && data.submittedAt <= request.time &&
        isValidClassification(data.classification) &&
        (!('classificationStartedAt' in data) || data.classificationStartedAt is timestamp) &&
        (!('studentName' in data) || validText(data.studentName, 200)) &&
        (!('studentId' in data) || validText(data.studentId, 40)) &&
        ((data.decision == 'pending' && !('reviewedBy' in data) && !('reviewedAt' in data)) ||
         (data.decision in ['approved', 'rejected'] && validId(data.reviewedBy) && data.reviewedAt is timestamp));
    }

    function isValidLeaveReview(requestId) {
      let data = request.resource.data;
      return isValidLeaveRequest(data) &&
        requestId == data.sessionId + '__' + data.studentUid &&
        get(/databases/$(database)/documents/sessions/$(data.sessionId)).data.classId == data.classId &&
        resource.data.decision == 'pending' && data.decision in ['approved', 'rejected'] &&
        data.diff(resource.data).affectedKeys().hasOnly(['decision', 'reviewedBy', 'reviewedAt']) &&
        data.reviewedBy == request.auth.uid && data.reviewedAt == request.time;
    }

    function canCreateAttendance(attendanceId, data) {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return data.keys().hasOnly(['sessionId', 'classId', 'studentUid', 'studentId', 'studentName', 'className', 'checkedInAt', 'notes']) &&
        isOwner(data.studentUid) && enrolledIn(data.classId) && validId(data.sessionId) &&
        data.studentId == profile.identifier && data.studentName == profile.name &&
        data.className == get(/databases/$(database)/documents/sessions/$(data.sessionId)).data.className &&
        data.checkedInAt == request.time && (!('notes' in data) || validText(data.notes, 250)) &&
        attendanceId == data.sessionId + '__' + request.auth.uid &&
        get(/databases/$(database)/documents/sessions/$(data.sessionId)).data.classId == data.classId &&
        get(/databases/$(database)/documents/sessions/$(data.sessionId)).data.status == 'DIBUKA';
    }

    function canCreateLeaveRequest(requestId, data) {
      return isValidLeaveRequest(data) && isOwner(data.studentUid) &&
        enrolledIn(data.classId) &&
        requestId == data.sessionId + '__' + request.auth.uid &&
        data.decision == 'pending' && data.submittedAt == request.time &&
        data.classification.status == 'pending' && !('classificationStartedAt' in data) &&
        (!('studentName' in data) || data.studentName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name) &&
        (!('studentId' in data) || data.studentId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.identifier) &&
        exists(/databases/$(database)/documents/sessions/$(data.sessionId)) &&
        get(/databases/$(database)/documents/sessions/$(data.sessionId)).data.classId == data.classId;
    }

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow create: if isOwner(uid) &&
        request.resource.data.keys().hasOnly(['name', 'identifier', 'role']) &&
        validText(request.resource.data.name, 200) &&
        validText(request.resource.data.identifier, 40) &&
        request.resource.data.role == 'PRAKTISAN';
    }

    match /classes/{classId} {
      allow get: if enrolledIn(classId);
      allow read: if hasRole('ASISTEN') && isOwner(resource.data.assistantUid);
      allow create: if hasRole('ASISTEN') &&
        request.resource.data.assistantUid == request.auth.uid &&
        request.resource.data.keys().hasOnly(['name', 'assistantUid']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0;
      allow update: if managesClass(classId) &&
        request.resource.data.assistantUid == request.auth.uid &&
        request.resource.data.keys().hasOnly(['name', 'assistantUid']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0;
      allow delete: if managesClass(classId);
    }

    match /enrollments/{uid}/classes/{classId} {
      allow read: if hasRole('PRAKTISAN') && isOwner(uid);
      allow create: if managesClass(classId) &&
        get(/databases/$(database)/documents/users/$(uid)).data.role == 'PRAKTISAN' &&
        request.resource.data.keys().hasOnly(['enrolledAt']) &&
        request.resource.data.enrolledAt is timestamp;
      allow delete: if managesClass(classId);
    }

    function isValidScheduledSession(data) {
      return data.keys().hasOnly(['classId', 'courseName', 'className', 'labRoom', 'date', 'startTime', 'endTime', 'assistantName', 'status',
                                  'labId', 'radiusMeters', 'scheduleRevision', 'startsAt', 'endsAt', 'attendanceConfig']) &&
        data.keys().hasAll(['classId', 'courseName', 'className', 'labRoom', 'date', 'startTime', 'endTime', 'assistantName', 'status']) &&
        data.status == 'TERJADWAL' && validId(data.classId) &&
        validText(data.courseName, 160) && validText(data.className, 120) &&
        validText(data.labRoom, 120) && validText(data.assistantName, 200) &&
        data.date is string && data.date.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$') &&
        data.startTime is string && data.startTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') &&
        data.endTime is string && data.endTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') &&
        (!('labId' in data) || data.labId in ['lab-ap', 'lab-b', 'lab-c', 'lab-d']) &&
        (!('radiusMeters' in data) || (data.radiusMeters is number && data.radiusMeters > 0)) &&
        (!('scheduleRevision' in data) || (data.scheduleRevision is int && data.scheduleRevision >= 1)) &&
        (!('startsAt' in data) || data.startsAt is timestamp) &&
        (!('endsAt' in data) || data.endsAt is timestamp);
    }

    match /sessions/{sessionId} {
      allow read: if enrolledIn(resource.data.classId) || managesClass(resource.data.classId);
      allow create: if isValidScheduledSession(request.resource.data) && managesClass(request.resource.data.classId);
      allow update: if managesClass(resource.data.classId) &&
        (isValidSessionUpdate() ||
         (resource.data.status == 'TERJADWAL' &&
          request.resource.data.status == 'TERJADWAL' &&
          request.resource.data.classId == resource.data.classId &&
          isValidScheduledSession(request.resource.data)));
      allow delete: if managesClass(resource.data.classId) && resource.data.status == 'TERJADWAL';
    }

    match /labs/{labId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Scope missing-document reads for check-in and leave transactions.
    function canReadMissingOwnRecord(id) {
      return hasRole('PRAKTISAN') && request.auth.uid.matches('^[A-Za-z0-9_-]+$') &&
        id.matches('^.+__' + request.auth.uid + '$');
    }

    match /attendance/{attendanceId} {
      allow get: if resource == null && canReadMissingOwnRecord(attendanceId);
      allow read: if canReadStudentRecord(resource.data);
      allow create: if canCreateAttendance(attendanceId, request.resource.data);
    }

    match /leaveRequests/{requestId} {
      allow get: if resource == null && canReadMissingOwnRecord(requestId);
      allow read: if canReadStudentRecord(resource.data);
      allow create: if canCreateLeaveRequest(requestId, request.resource.data);
      allow update: if managesClass(resource.data.classId) && isValidLeaveReview(requestId);
    }
  }
}
