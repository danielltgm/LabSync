# Copy to .env.local. Emulator mode uses a synthetic Firebase project.
EXPO_PUBLIC_FIREBASE_EMULATORS=true
# Set to your computer's LAN IP when running Expo Go on a physical device.
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1

# Fill these from the LabSync Firebase web app when using the shared dev project.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
