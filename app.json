{
  "expo": {
    "name": "LabSync",
    "slug": "LabSync",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "labsync",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": false
    },
    "android": {
      "package": "com.myudak.labsync",
      "adaptiveIcon": {
        "backgroundColor": "#F46143",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#D3E1D8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#141414",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LabSync memakai lokasimu untuk memastikan kamu berada di lab saat presensi."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "LabSync memakai kamera untuk memindai QR presensi dari asisten.",
          "recordAudioAndroid": false
        }
      ],
      "expo-maps",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "LabSync memakai galeri untuk menambahkan foto ruangan lab.",
          "cameraPermission": "LabSync memakai kamera untuk memindai QR presensi dan memotret ruangan lab.",
          "microphonePermission": false
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "83fe907d-bd2f-4202-b971-8462539da038"
      }
    },
    "owner": "myudak"
  }
}
